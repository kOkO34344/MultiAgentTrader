# ---------------------------------------------------------------------------
# Multi-Agent Options Desk — environment
# Copy to `.env` and fill in. NEVER commit the real .env.
# ---------------------------------------------------------------------------

# --- Alpaca PAPER trading (required) --------------------------------------
# Create a dedicated paper account for the hackathon:
#   https://app.alpaca.markets/paper/dashboard/overview
ALPACA_API_KEY_ID=PK_your_paper_key_here
ALPACA_API_SECRET_KEY=your_paper_secret_here

# Paper endpoint. The desk REFUSES to start against the live endpoint.
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# Market data feed: "iex" (free) or "sip" (paid subscription)
ALPACA_DATA_FEED=iex

# --- Claude (optional) ------------------------------------------------------
# If unset, every LLM agent falls back to deterministic mock reasoning so the
# whole pipeline still runs end-to-end offline (tests rely on this).
ANTHROPIC_API_KEY=

# --- Runtime ----------------------------------------------------------------
# Global kill switch. "true" = analyse and log, never send orders.
DESK_DRY_RUN=true

# Experiment id recorded on every trade + decision trace.
DESK_EXPERIMENT_ID=baseline-v1

# Logging: DEBUG | INFO | WARNING | ERROR
DESK_LOG_LEVEL=INFO

# Web dashboard bind address
DESK_DASHBOARD_HOST=127.0.0.1
DESK_DASHBOARD_PORT=8787
